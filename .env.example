TYPESAFE_API_KEY=your_key
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional. Defaults to jev-1.13.0, the version every number in results/ was measured on.
# TYPESAFE_MODEL=jev-1.13.0

# Optional. Directory of French .md prose that P4 and P5 use as filler.
# Defaults to data/fr-corpus/.
# FR_CORPUS=/path/to/french/markdown

# Optional. Only for the OpenRouter models of the bench (bench/models/openai_compat.py).
# OPENROUTER_API_KEY=
